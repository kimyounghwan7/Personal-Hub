{
  "permissions": {
    "ask": [
      "Bash(docker build *)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic downgrade *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/destructive-guard.sh",
            "timeout": 10,
            "statusMessage": "파괴적 명령 묶음 검사"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-policy.sh",
            "timeout": 30,
            "statusMessage": "git 정책"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-check-on-commit.sh",
            "timeout": 120,
            "statusMessage": "문서 검사(docs_check)"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/comment-guard.sh",
            "timeout": 60,
            "statusMessage": "주석 규칙(구분선 · 날짜 · 긴 덩어리)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shape-guard.sh",
            "timeout": 60,
            "statusMessage": "감싸기 규칙(호출 하나뿐인 함수)"
          }
        ]
      }
    ]
  }
}
