# Environment ("local" | "development" | "production")
ENVIRONMENT=local

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
ALLOW_SUPABASE_AUTH_FALLBACK=false

# Database (Prefer Supabase Session Pooler on port 6543; URL-encode special password characters)
DATABASE_URL=postgresql://postgres.your-project:your-encoded-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Admin Bootstrap & URLs
ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

